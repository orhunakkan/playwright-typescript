{
  "name": "agentic-playwright-framework",
  "version": "1.0.0",
  "description": "Playwright-Typescript Framework",
  "license": "ISC",
  "author": "Orhun Akkan",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "env:check": "node scripts/env-check.ts",
    "test": "playwright test",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit --project=mobile-chrome --project=mobile-safari",
    "test:api": "playwright test --project=api",
    "test:a11y": "playwright test --project=a11y",
    "test:perf": "playwright test --project=perf",
    "test:visual": "node scripts/docker-playwright.ts --project=visual",
    "test:visual:update": "node scripts/docker-playwright.ts --project=visual --update-snapshots",
    "contract:pull": "node scripts/contract-pull.ts",
    "test:scripts": "node --test \"scripts/**/*.test.ts\"",
    "stlc:lint": "node scripts/stlc/lint.ts",
    "stlc:gate": "node scripts/stlc/gate.ts",
    "stlc:new": "node scripts/stlc/new.ts",
    "stlc:run-summary": "node scripts/stlc/run-summary.ts",
    "stlc:defect": "node scripts/stlc/defect.ts",
    "stlc:trace": "node scripts/stlc/trace.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "0.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-playwright": "^2.12.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}

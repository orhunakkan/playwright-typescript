# Copy to .env and fill in. .env and .env.* are git-ignored (except this file).
# Load order, first value wins: shell > .env.<ENV> > .env

# Target under test (pilot: Practice Software Testing "Toolshop")
BASE_URL=https://practicesoftwaretesting.com
API_URL=https://api.practicesoftwaretesting.com
# Path that returns 2xx on the API; used by `npm run env:check`. Defaults to /
API_HEALTH_PATH=/products

# TypeSafe key for the Jev skill-routing hook (.claude/hooks/jev-skill-router.mts)
TYPESAFE_API_KEY=

# Switching targets: create .env.<name> and run with ENV=<name>, e.g. .env.with-bugs:
#   BASE_URL=https://with-bugs.practicesoftwaretesting.com
#   API_URL=https://api-with-bugs.practicesoftwaretesting.com
# then: ENV=with-bugs npm test

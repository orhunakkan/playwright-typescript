{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run *)",
      "Bash(npx playwright test *)",
      "Bash(npx playwright trace *)",
      "PowerShell(npm run *)",
      "PowerShell(npx playwright test *)",
      "PowerShell(npx playwright trace *)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/jev-skill-router.mts\"",
            "timeout": 15,
            "statusMessage": "Jev is picking agent-skills…"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-plan-approval.mts\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
